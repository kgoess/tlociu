<div id="create-update">
<% IF vars.error_message %>
    <div class="error">ERROR: <% vars.error_message | html %></div>
<% END %>
    <form method="post" action="<% post_to %>">
        <input type="hidden" name="csrf_token" value="<% current_csrf | html %>">
        <div class="field">
            <label for="title">Title</label>
            <% IF vars.title %>
                <input type="hidden" name="title" value="<% vars.title | html %>"><% vars.title | html %>
            <% ELSE %>
                <input type="text" name="title" id="title" value="<% vars.title | html %>" required>
            <% END %>
        </div>
        <div class="field">
            <label for="tmdb_id">TMDB ID</label>
            <% IF vars.tmdb_id %>
                <input type="hidden" name="tmdb_id" value="<% vars.tmdb_id | html %>"><% vars.tmdb_id | html %>
            <% ELSE %>
                <input type="text" name="tmdb_id" id="tmdb_id" value="<% vars.tmdb_id | html %>" required>
            <% END %>
        </div>
        <div class="field">
            <label for="watchlist_notes">Watchlist Notes</label>
            <textarea name="watchlist_notes" id="watchlist_notes" cols="50" rows="10" required><% vars.watchlist_notes | html %></textarea>
        </div>
        <div class="field inline">
            <label for="watchlist_notes_visibility">Who can see these notes:</label>
            <select name="watchlist_notes_visibility" id="watchlist_notes_visibility">
                <option value="" <% vars.watchlist_notes_visibility ? '' : 'selected' %>>Same as entry</option>
                <option value="users" <% vars.watchlist_notes_visibility == 'users' ? 'selected' : '' %>>Signed-in tlociu users</option>
                <option value="private" <% vars.watchlist_notes_visibility == 'private' ? 'selected' : '' %>>Only me</option>
            </select>
        </div>
        <div class="field">
            <label for="date_added">Date Added</label>
            <input type="date" name="date_added" id="date_added" value="<% vars.date_added %>" required>
        </div>
        <div class="field <% vars.changing_watched ? 'highlight-input' : '' %>">
            Watched?
            <label for="watched-yes" class="radiobutton">Yes</label>
            <input type="radio" id="watched-yes" name="watched" value="1" <% IF vars.watched ; 'checked'; END %>>
            <label for="watched-no" class="radiobutton">No</label>
            <input type="radio" id="watched-no" name="watched" value="0" <% IF !vars.watched ; 'checked'; END %>>
            <% IF vars.changing_watched %>
                    (Updating watched status for <i><% vars.title %></i>.)
            <% END %>
        </div>
        <div class="field">
            <label for="watched_notes">Watched Notes</label>
            <textarea name="watched_notes" id="watched_notes" cols="50" rows="10" <% vars.changing_watched ? 'autofocus' : '' %>><% vars.watched_notes | html %></textarea>
        </div>
        <div class="field inline">
            <label for="watched_notes_visibility">Who can see these notes:</label>
            <select name="watched_notes_visibility" id="watched_notes_visibility">
                <option value="" <% vars.watched_notes_visibility ? '' : 'selected' %>>Same as entry</option>
                <option value="users" <% vars.watched_notes_visibility == 'users' ? 'selected' : '' %>>Signed-in tlociu users</option>
                <option value="private" <% vars.watched_notes_visibility == 'private' ? 'selected' : '' %>>Only me</option>
            </select>
        </div>
        <div class="field">
            <label for="date_watched">Date Watched</label>
            <input type="date" name="date_watched" id="date_watched" value="<% vars.date_watched| html %>">
        </div>
        <div class="field">
            <label for="tags">Tags</label>
            <input type="text" name="tags" id="tags" value="<% vars.tags | html %>" autocomplete="off"
                   placeholder="e.g. horror, light entertainment">
            <p class="field-hint">Separate tags with commas. New tags start out private; you can
            change who sees each tag on the <a href="<% request.uri_for('/tags') %>">Tags</a> page.</p>
            <% IF user_tags.size %>
            <div class="tag-suggestions">
                <% FOREACH name IN user_tags %>
                <button type="button" class="tag tag-suggestion" data-tag="<% name | html %>"><% name | html %></button>
                <% END %>
            </div>
            <script>
            (function () {
                var input = document.getElementById('tags');
                var buttons = document.querySelectorAll('.tag-suggestion');

                function currentTags() {
                    return input.value.split(',')
                        .map(function (t) { return t.trim(); })
                        .filter(function (t) { return t !== ''; });
                }
                function hasTag(name) {
                    return currentTags().some(function (t) { return t.toLowerCase() === name.toLowerCase(); });
                }
                function markUsed() {
                    buttons.forEach(function (b) { b.classList.toggle('tag-active', hasTag(b.dataset.tag)); });
                }

                // click a suggestion to add it, click again to take it back out
                buttons.forEach(function (button) {
                    button.addEventListener('click', function () {
                        var name = button.dataset.tag;
                        var tags = hasTag(name)
                            ? currentTags().filter(function (t) { return t.toLowerCase() !== name.toLowerCase(); })
                            : currentTags().concat([name]);
                        input.value = tags.join(', ');
                        markUsed();
                    });
                });
                input.addEventListener('input', markUsed);
                markUsed();
            })();
            </script>
            <% END %>
        </div>
        <div class="field inline">
            <div class="field-legend">Visibility</div>
            <% SET visibility = vars.visibility || 'users' %>
            <input type="radio" name="visibility" id="visibility-public" value="public" <% visibility == 'public' ? 'checked' : '' %>>
            <label for="visibility-public">Public</label>
            &nbsp;
            <input type="radio" name="visibility" id="visibility-users" value="users" <% visibility == 'users' ? 'checked' : '' %>>
            <label for="visibility-users">Signed-in tlociu users</label>
            &nbsp;
            <input type="radio" name="visibility" id="visibility-private" value="private" <% visibility == 'private' ? 'checked' : '' %>>
            <label for="visibility-private">Private</label>
        </div>
        <input type="submit">
    </form>
</div>
