<html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <style>
            .main-box{
                border: 1px solid grey;
                padding: 3px;
                width: fit-content;
                margin: auto;
            }
            .one-button{
                width: fit-content;
                margin: 1em auto;
            }
            .login-div{
                width: fit-content;
                margin: auto;
            }
            .login-div button{
                margin: auto;
            }

        </style>
        <script src="https://accounts.google.com/gsi/client" async defer></script>
        <script src="https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js"></script>
    </head>
    <body>
        <div class="main-box">
            <div class="google one-button"><!-- google login button -->
                 <!-- e.g. 1098...na1g.apps.googleusercontent.com -->
                <div id="g_id_onload"
                     data-client_id="<% google_client_id | html %>"
                     data-ux_mode="redirect"
                     data-login_uri="<% request.uri_for('/google-signin') %>">
                </div>
                <div class="g_id_signin" data-type="standard"></div>
            </div>
            <div class="apple one-button"><!-- apple login button -->
                <div id="appleid-signin"
                     data-color="black"
                     data-border="true"
                     data-type="sign-in"
                     data-width="200"
                     data-height="40">
                </div>
                <script>
                    AppleID.auth.init({
                        clientId: "<% apple_client_id | html %>",
                        scope: "email",
                        redirectURI: "<% request.uri_for('/apple-signin') %>",
                        usePopup: false
                    });
                </script>
            </div>
            <div style="text-align: center; font-size: small; margin-top: 1em;">
                <a href="<% request.uri_for('/privacy') %>">Privacy Policy</a>
                &middot;
                <a href="<% request.uri_for('/terms') %>">Terms of Service</a>
            </div>
        </div>
        <!-- <div class="bacds one-button">
            <button onclick="document.location='bacds-signin.html'">Login via BACDS</button>
        </div>
        <div>
            Contact web-committee for access.
        </div>
        -->
    </body>
</html>

